+                  background: tone === t.id ? "#f97316" : "#161b22",
+                  color: tone === t.id ? "#000" : "#7d8590",
+                }}>{t.label}</button>
+              ))}
+            </div>
+          </div>
+        </div>
+
+        {/* ── RIGHT: Topic + Output ── */}
+        <div style={{ flex: 1, display: "flex", flexDirection: "column" }}>
+          {/* Topic input */}
+          <div style={{ marginBottom: 16 }}>
